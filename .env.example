# Server only. Copy to .env.local for npm start. Never put real values in this file.
MERRIAM_WEBSTER_API_KEY=
# Keep false until written approval covers automated generation, storage and offline distribution.
MW_LICENSE_APPROVED=false
# A separate random admin password (32+ characters); generate with npm run setup:secrets.
WORDS_LINK_ADMIN_TOKEN=
# An immutable dataset name. Choose a NEW name when replacing a published dictionary.
MW_DATASET_VERSION=mw-v1
# Set a future New York date only AFTER the dataset has been generated and reviewed.
# Leave empty to keep the current WordNet dictionary active.
MW_ACTIVATE_ON=
# Used only by the local setup client; not a secret.
WORDS_LINK_SITE_URL=http://127.0.0.1:8081
